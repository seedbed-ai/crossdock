{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/seedbed-ai/crossdock/main/schemas/crossdock-handoff-v1.schema.json",
  "title": "Crossdock chat-agent handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["crossdock", "version", "agent", "prompt"],
  "properties": {
    "crossdock": { "const": "handoff" },
    "version": { "const": 1 },
    "agent": { "const": "codex" },
    "prompt": { "type": "string", "minLength": 1 }
  }
}
